# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_db

# ── Relojes Hikvision ────────────────────────────────────────────────────────
HIK_USER=admin
HIK_PASSWORD=tu_contraseña_hikvision
# JSON array con host e identificador de cada reloj
HIK_DEVICES=[{"host":"10.10.0.10","name":"fabrica"},{"host":"10.10.0.11","name":"oficina"}]

# ── Paginación / reintentos (opcionales) ────────────────────────────────────
HIK_PAGE_SIZE=30
HIK_MAX_RETRIES=4
HIK_RETRY_BACKOFF=2.0

# ── Clasificación turno (hora de corte entrada/salida) ───────────────────────
CLASIF_CUTOFF_HOUR=12
CLASIF_DEVICES=fabrica,oficina

# ── Reloj Anviz (protocolo TCP) ──────────────────────────────────────────────
ANVIZ_ENABLED=1
ANVIZ_IP=10.10.0.147
ANVIZ_PORT=5010
ANVIZ_DEVICE=anviz

# ── API / seguridad ──────────────────────────────────────────────────────────
API_TOKEN=token_secreto_para_la_api

# ── Zona horaria ─────────────────────────────────────────────────────────────
TZ=America/Argentina/Buenos_Aires
